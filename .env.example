# PostgreSQL. URL-encode special characters in passwords.
POSTGRES_PASSWORD=replace-with-a-long-random-database-password
DATABASE_URL=postgresql://surgeon:replace-with-a-long-random-database-password@db:5432/surgeon
APP_URL=http://localhost:3000
APP_PORT=3000

# The first administrator is created only when no ADMIN exists.
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-long-unique-password

# SMTP is mandatory in production. Without it development emails go to DEV_MAIL_DIR.
SMTP_URL=smtps://user:password@smtp.example.com:465
EMAIL_FROM=Website <no-reply@example.com>
DEV_MAIL_DIR=/tmp/surgeon-website-mail

# Local uploads must be on a persistent volume outside the repository.
LOCAL_STORAGE_DIR=/data/uploads

# Optional S3-compatible storage. When set, it replaces LOCAL_STORAGE_DIR.
S3_ENDPOINT=https://storage.example.com
S3_REGION=ru-central1
S3_BUCKET=surgeon-private
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true

PRIVACY_VERSION=2026-11-25
TERMS_VERSION=2026-11-25
